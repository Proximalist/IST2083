{
  "name": "IST2083 — R + Quarto",
  "image": "ghcr.io/rocker-org/devcontainer/tidyverse:4.4",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "1.6.40",
      "installTinyTex": true
    }
  },
  "postCreateCommand": "Rscript scripts/paketler.R",
  "customizations": {
    "vscode": {
      "extensions": ["quarto.quarto", "REditorSupport.r"]
    }
  },
  "remoteUser": "rstudio"
}
